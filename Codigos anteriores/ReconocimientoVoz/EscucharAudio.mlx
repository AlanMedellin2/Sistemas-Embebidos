%% CONFIG SERIAL
port = "COM3";    
baud = 115200;
expectedSamples = 32000;
Fs = 7800; % ~14.4 kHz real (PSC=4, ARR=2249 en H755)

disp("Conectando puerto serial...");
s = serialport(port, baud);
configureTerminator(s, "LF");


flush(s);

disp("Coloca el STM32 en estado MEASURE y presiona ENTER...");
pause;

disp("Esperando datos...");
tic;

data = zeros(expectedSamples,1);

for i = 1:expectedSamples
    line = readline(s);
    val = str2double(line);
    if isnan(val), val = 0; end
    data(i) = val;
end

tRead = toc;
fprintf("Recepción completa en %.2f s\n", tRead);

%% Convertir a audio normalizado
audio = (data - mean(data)) / max(abs(data));

%% Guardar archivo WAV
filename = "mic_audio.wav";
audiowrite(filename, audio, Fs);
disp("Archivo guardado: " + filename);

%% Reproducir audio
sound(audio, Fs);

%% Graficar
figure;
plot(audio);
title("Audio reconstruido STM32");
xlabel("Muestras");
ylabel("Amplitud");
